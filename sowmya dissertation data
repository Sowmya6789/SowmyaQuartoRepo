        "if any(c+\"_num\" in df.columns for c in IG_TRUST):\n",
        "    df['IG_Trust'] = row_mean(IG_TRUST)\n",
        "else:\n",
        "    df['IG_Trust'] = np.nan\n",
        "    print(\"Warning: IG_Trust not created - no Instagram trust columns found\")\n",
        "\n",
        "if any(c+\"_num\" in df.columns for c in IG_BEHAV):\n",
        "    df['IG_PI'] = row_mean(IG_BEHAV)\n",
        "else:\n",
        "    df['IG_PI'] = np.nan\n",
        "    print(\"Warning: IG_PI not created - no Instagram behavior columns found\")\n",
        "\n",
        "df['TT_Trust'] = row_mean(TT_TRUST)\n",
        "df['TT_PI'] = row_mean(TT_BEHAV)\n",
        "\n",
        "# ====== STEP 5: DESCRIPTIVES & CORRELATIONS ======\n",
        "def desc(s):\n",
        "    x = pd.to_numeric(s, errors='coerce').dropna()\n",
        "    if x.empty:\n",
        "        return {\"N\":0,\"Mean\":np.nan,\"SD\":np.nan,\"Min\":np.nan,\"Max\":np.nan}\n",
        "    return {\"N\":int(x.size),\"Mean\":round(float(x.mean()),2),\"SD\":round(float(x.std(ddof=1)),2),\n",
        "            \"Min\":round(float(x.min()),2),\"Max\":round(float(x.max()),2)}\n",
        "\n",
        "def corr(a,b):\n",
        "    d = pd.concat([a,b],axis=1).dropna()\n",
        "    if d.shape[0] < 3:\n",
        "        return np.nan, np.nan, d.shape[0]\n",
        "    r,p = pearsonr(d.iloc[:,0], d.iloc[:,1])\n",
        "    return round(float(r),3), round(float(p),3), int(d.shape[0])\n",
        "\n",
