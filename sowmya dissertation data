      "cell_type": "code",
      "source": [
        "# === SETUP ===\n",
        "!pip -q install openpyxl\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy.stats import pearsonr\n",
        "\n",
        "# ====== STEP 1: LOAD YOUR FILE ======\n",
        "FILE_PATH = \"survey_October 21, 2025_18.36.xlsx\"\n",
        "\n",
        "df = pd.read_excel(FILE_PATH)\n",
        "print(\"Loaded:\", df.shape)\n",
        "\n",
        "# ====== STEP 2: COLUMN MAP (CORRECTED based on actual file structure) ======\n",
        "# Platform selection column (Instagram / TikTok)\n",
        "PLATFORM_COL = 'Q3'  # \"Which platform do you use more for shopping-related content?\"\n",
        "\n",
        "# Instagram blocks (based on actual column structure):\n",
        "IG_EXPOSURE = ['_1','_2','_3','_4']\n",
        "IG_TRUST    = ['_1.1','_2.1','_3.1','_4.1']        # Instagram influencer trust items\n",
        "IG_PSYCH    = ['_1.2','_2.2','_3.2','_4.2']        # Instagram FOMO/psych triggers\n",
        "IG_BEHAV    = ['_1.3','_2.3','_3.3','_4.3']        # Instagram purchasing behaviour (PI proxy)\n",
        "\n",
        "# TikTok blocks:\n",
        "TT_EXPOSURE = ['Q4 - Q7_1','Q4 - Q7_2','Q4 - Q7_3','Q4 - Q7_4']\n",
        "TT_TRUST    = ['Q8 - Q11_1','Q8 - Q11_2','Q8 - Q11_3','Q8 - Q11_4']\n",
        "TT_PSYCH    = ['Q12 - Q15_1','Q12 - Q15_2','Q12 - Q15_3','Q12 - Q15_4']\n",
        "TT_BEHAV    = ['Q16 -Q19_1','Q16 -Q19_2','Q16 -Q19_3','Q16 -Q19_4']  # PI proxy\n",
        "\n",
        "# ====== STEP 3: LIKERT MAPPING ======\n",
        "LIKERT_MAP = {\n",
        "    \"strongly agree\": 5,\n",
        "    \"agree\": 4,\n",
        "    \"neutral\": 3,\n",
        "    \"disagree\": 2,\n",
        "    \"strongly disagree\": 1\n",
        "}\n",
        "\n",
        "def map_likert(col):\n",
        "    if col not in df.columns:\n",
        "        print(f\"Warning: Column '{col}' not found in dataframe\")\n",
        "        return None\n",
        "    s = df[col]\n",
        "    # Handle NaN values and convert to string\n",
        "    out = s.fillna('').astype(str).str.strip().str.lower().map(LIKERT_MAP)\n",
        "    df[col+\"_num\"] = pd.to_numeric(out, errors='coerce')\n",
        "    return col+\"_num\"\n",
        "\n",
        "print(\"Mapping Likert scales...\")\n",
        "all_cols = IG_EXPOSURE + IG_TRUST + IG_PSYCH + IG_BEHAV + TT_EXPOSURE + TT_TRUST + TT_PSYCH + TT_BEHAV\n",
        "\n",
        "# Check which columns exist\n",
        "existing_cols = []\n",
        "missing_cols = []\n",
        "for c in all_cols:\n",
        "    if c in df.columns:\n",
        "        existing_cols.append(c)\n",
        "    else:\n",
        "        missing_cols.append(c)\n",
        "\n",
        "print(f\"Found {len(existing_cols)} columns, missing {len(missing_cols)} columns\")\n",
        "if missing_cols:\n",
        "    print(\"Missing columns:\", missing_cols)\n",
        "\n",
        "for c in existing_cols:\n",
        "    map_likert(c)\n",
        "\n",
        "# ====== STEP 4: BUILD CONSTRUCT SCORES ======\n",
        "def row_mean(cols):\n",
        "    cols_num = [c+\"_num\" for c in cols if (c+\"_num\") in df.columns]\n",
        "    if not cols_num:\n",
        "        return pd.Series([np.nan]*len(df))\n",
        "    return df[cols_num].mean(axis=1, skipna=True)\n",
        "\n",
        "df['IG_Trust'] = row_mean(IG_TRUST)\n",
        "df['IG_PI']    = row_mean(IG_BEHAV)   # purchase intention proxy (behavioural intention set)\n",
        "\n",
        "df['TT_Trust'] = row_mean(TT_TRUST)\n",
        "df['TT_PI']    = row_mean(TT_BEHAV)\n",
        "\n",
        "# ====== STEP 5: DESCRIPTIVES & CORRELATIONS ======\n",
        "def desc(s):\n",
        "    x = pd.to_numeric(s, errors='coerce').dropna()\n",
        "    if x.empty:\n",
        "        return {\"N\":0,\"Mean\":np.nan,\"SD\":np.nan,\"Min\":np.nan,\"Max\":np.nan}\n",
        "    return {\"N\":int(x.size),\"Mean\":round(float(x.mean()),2),\"SD\":round(float(x.std(ddof=1)),2),\n",
        "            \"Min\":round(float(x.min()),2),\"Max\":round(float(x.max()),2)}\n",
        "\n",
        "def corr(a,b):\n",
        "    d = pd.concat([a,b],axis=1).dropna()\n",
        "    if d.shape[0] < 3:\n",
        "        return np.nan, np.nan, d.shape[0]\n",
        "    r,p = pearsonr(d.iloc[:,0], d.iloc[:,1])\n",
        "    return round(float(r),3), round(float(p),3), int(d.shape[0])\n",
        "\n",
        "print(\"\\n=== UNFILTERED (anyone who answered the items) ===\")\n",
        "print(\"IG Trust:\", desc(df['IG_Trust']))\n",
        "print(\"IG PI   :\", desc(df['IG_PI']))\n",
        "print(\"TT Trust:\", desc(df['TT_Trust']))\n",
        "print(\"TT PI   :\", desc(df['TT_PI']))\n",
        "print(\"IG Trust ↔ IG PI:\", corr(df['IG_Trust'], df['IG_PI']))\n",
        "print(\"TT Trust ↔ TT PI:\", corr(df['TT_Trust'], df['TT_PI']))\n",
        "\n",
        "# ====== STEP 6: FILTER BY DECLARED PLATFORM ======\n",
        "plat = df[PLATFORM_COL].astype(str).str.strip().str.lower()\n",
        "IG = df[plat=='instagram'].copy()\n",
        "TT = df[plat=='tiktok'].copy()\n",
        "\n",
        "print(\"\\n=== PLATFORM COUNTS ===\")\n",
        "print(df[PLATFORM_COL].value_counts(dropna=False))\n",
        "\n",
        "print(\"\\n=== FILTERED by declared platform ===\")\n",
        "print(\"IG (declared) Trust:\", desc(IG['IG_Trust']))\n",
        "print(\"IG (declared) PI   :\", desc(IG['IG_PI']))\n",
        "if len(IG) > 0:\n",
        "    print(\"IG Trust ↔ IG PI (declared):\", corr(IG['IG_Trust'], IG['IG_PI']))\n",
        "else:\n",
        "    print(\"IG Trust ↔ IG PI (declared): No Instagram users found\")\n",
        "\n",
        "print(\"TT (declared) Trust:\", desc(TT['TT_Trust']))\n",
        "print(\"TT (declared) PI   :\", desc(TT['TT_PI']))\n",
        "if len(TT) > 0:\n",
        "    print(\"TT Trust ↔ TT PI (declared):\", corr(TT['TT_Trust'], TT['TT_PI']))\n",
        "else:\n",
        "    print(\"TT Trust ↔ TT PI (declared): No TikTok users found\")\n",
        "\n",
        "# ====== STEP 7: EXPORT CSVs ======\n",
        "desc_rows = [\n",
        "    {\"Metric\":\"IG Trust (unf)\", **desc(df['IG_Trust'])},\n",
        "    {\"Metric\":\"IG PI (unf)\",    **desc(df['IG_PI'])},\n",
        "    {\"Metric\":\"TT Trust (unf)\", **desc(df['TT_Trust'])},\n",
        "    {\"Metric\":\"TT PI (unf)\",    **desc(df['TT_PI'])},\n",
        "    {\"Metric\":\"IG Trust (declared)\", **desc(IG['IG_Trust'])},\n",
        "    {\"Metric\":\"IG PI (declared)\",    **desc(IG['IG_PI'])},\n",
        "    {\"Metric\":\"TT Trust (declared)\", **desc(TT['TT_Trust'])},\n",
        "    {\"Metric\":\"TT PI (declared)\",    **desc(TT['TT_PI'])},\n",
        "]\n",
        "desc_df = pd.DataFrame(desc_rows)\n",
        "\n",
        "# FIXED: Properly handle correlation records without dictionary unpacking syntax error\n",
        "corr_records = []\n",
        "\n",
        "# Unfiltered correlations\n",
        "ig_corr_unf = corr(df['IG_Trust'], df['IG_PI'])\n",
        "tt_corr_unf = corr(df['TT_Trust'], df['TT_PI'])\n",
        "\n",
        "corr_records.append({\n",
        "    \"Correlation\": \"IG Trust ↔ IG PI (unf)\",\n",
        "    \"r\": ig_corr_unf[0],\n",
        "    \"p\": ig_corr_unf[1],\n",
        "    \"N\": ig_corr_unf[2]\n",
        "})\n",
        "corr_records.append({\n",
        "    \"Correlation\": \"TT Trust ↔ TT PI (unf)\",\n",
        "    \"r\": tt_corr_unf[0],\n",
        "    \"p\": tt_corr_unf[1],\n",
        "    \"N\": tt_corr_unf[2]\n",
        "})\n",
        "\n",
        "# Platform-filtered correlations\n",
        "if len(IG) > 0:\n",
        "    ig_corr_dec = corr(IG['IG_Trust'], IG['IG_PI'])\n",
        "    corr_records.append({\n",
        "        \"Correlation\": \"IG Trust ↔ IG PI (declared)\",\n",
        "        \"r\": ig_corr_dec[0],\n",
        "        \"p\": ig_corr_dec[1],\n",
        "        \"N\": ig_corr_dec[2]\n",
        "    })\n",
        "\n",
        "if len(TT) > 0:\n",
        "    tt_corr_dec = corr(TT['TT_Trust'], TT['TT_PI'])\n",
        "    corr_records.append({\n",
        "        \"Correlation\": \"TT Trust ↔ TT PI (declared)\",\n",
        "        \"r\": tt_corr_dec[0],\n",
        "        \"p\": tt_corr_dec[1],\n",
        "        \"N\": tt_corr_dec[2]\n",
        "    })\n",
        "\n",
        "corr_df = pd.DataFrame(corr_records)\n",
        "\n",
        "desc_path = \"verified_desc_platform_filtered.csv\"\n",
        "corr_path = \"verified_corr_platform_filtered.csv\"\n",
        "scores_path = \"verified_scores_platform_filtered.csv\"\n",
        "df_out = df[[PLATFORM_COL,'IG_Trust','IG_PI','TT_Trust','TT_PI']]\n",
        "\n",
        "desc_df.to_csv(desc_path, index=False)\n",
        "corr_df.to_csv(corr_path, index=False)\n",
        "df_out.to_csv(scores_path, index=False)\n",
        "\n",
        "print(\"\\nSaved:\")\n",
        "print(desc_path, corr_path, scores_path)\n",
        "\n",
        "# Additional debug info\n",
        "print(f\"\\n=== DEBUG INFO ===\")\n",
        "print(f\"Total rows: {len(df)}\")\n",
        "print(f\"Instagram users: {len(IG)}\")\n",
        "print(f\"TikTok users: {len(TT)}\")\n",
        "print(f\"Sample of numeric columns: {[col for col in df.columns if '_num' in col][:5]}...\")"
